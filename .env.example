# -------------------------------------------------------------------
# Nexus AI - Environment Variables Example
# Recommended location: nexus-ai/.env
# -------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-20250514

# Gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_TEXT_MODEL=deepseek-chat

# xAI
XAI_API_KEY=your-xai-key
XAI_TEXT_MODEL=grok-4-fast
XAI_IMAGE_MODEL=grok-imagine-image

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TEXT_MODEL=llama3.1:8b

# Custom injected provider (OpenAI-compatible local server)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=llama-3.1-8b-instruct
LOCAL_LLM_API_KEY=local-no-key

# Custom injected provider for image generation
LOCAL_IMAGE_BASE_URL=http://localhost:1234/v1
LOCAL_IMAGE_MODEL=local-image-model-v1
LOCAL_IMAGE_API_KEY=local-no-key
