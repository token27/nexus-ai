{
  "name": "token27/nexus-ai",
  "description": "Framework-agnostic AI communication engine with middleware pipeline architecture",
  "type": "library",
  "homepage": "https://github.com/token27/nexus-ai",
  "authors": [
    {
      "name": "Token27",
      "homepage": "https://github.com/token27",
      "role": "Maintainer"
    },
    {
      "name": "Contributors",
      "homepage": "https://github.com/token27/nexus-ai/graphs/contributors",
      "role": "Contributor"
    }
  ],
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "php",
    "psr-18",
    "middleware"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "token27/nexus-ai-pricing": "^1.0"
  },
  "suggest": {
    "token27/nexus-ai-tokenizer": "Enables token-accurate pre-request estimation via CostCalculator::estimate(). Without it, CostCalculator falls back to mb_strlen/4 approximation."
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "guzzlehttp/guzzle": "7.*",
    "nyholm/psr7": "^1.8",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0",
    "psr/http-client": "1.*",
    "psr/http-factory": "1.*"
  },
  "autoload": {
    "psr-4": {
      "Token27\\NexusAI\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Token27\\NexusAI\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration",
    "test:coverage": "phpunit --coverage-text",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "lint-fix": "php-cs-fixer fix",
    "analyse": "phpstan analyse --level=8 src/",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
